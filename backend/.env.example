PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stock_capture_db

# Opsional: Jalur file cookies sesi Stockbit (default: ./cookies.json)
COOKIES_PATH=./cookies.json

# Streaming Real-Time Orderbook (Mode 2)
# Interval sampling & throttling bulk insert database (default: 30000 = 30 detik)
STREAM_INTERVAL_MS=30000
# Batas maksimal emiten yang di-stream secara bersamaan untuk stabilitas memori RAM
MAX_STREAM_SYMBOLS=5
# Set true untuk mencetak sampel frame WebSocket mentah ke konsol saat kalibrasi
DEBUG_WS=false

# Opsional: Jika ingin menaruh cookies langsung dalam format JSON string
# STOCKBIT_COOKIES=[{"name":"credentialStorage","value":"...","domain":".stockbit.com","path":"/"}]
